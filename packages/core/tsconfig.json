{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // @hebcal/core 3.50.4 declares `typings` but its `exports` map has no `types` condition,
    // so bundler resolution cannot find its declarations without this mapping. Its
    // declarations also reference Node's types, hence @types/node in devDependencies.
    "paths": {
      "@hebcal/core": ["./node_modules/@hebcal/core/hebcal.d.ts"]
    }
  },
  "include": ["src"]
}
